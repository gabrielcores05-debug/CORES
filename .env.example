# ========================================================
# CONFIGURACIÓN DE PRODUCCIÓN - CORES COMUNICACIONES S.A.S.
# ========================================================

# Tipo de Base de Datos: 'mysql' (o 'sqlite' para pruebas)
DB_TYPE=mysql

# Credenciales de Base de Datos MySQL en la Nube
# (Obtén estos datos en Clever Cloud, Aiven, TiDB, Alwaysdata o Railway)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=CORES
DB_USER=root
DB_PASS=

# Configuración de Entorno ('production' o 'development')
APP_ENV=production
